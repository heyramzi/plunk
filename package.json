    "deepmerge-ts": ">=8.0.0 <9",
    "dompurify": ">=3.4.13 <4",
    "effect": ">=3.20.0 <4",
    "engine.io": ">=6.6.7 <7",
    "esbuild": ">=0.28.1 <0.29",
