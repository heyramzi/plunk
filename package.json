    "@vitest/ui": "^4.0.14",
    "dotenv": "^17.0.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "form-data": "^4.0.3",
